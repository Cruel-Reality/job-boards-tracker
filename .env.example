# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is gitignored and must never be committed.

# Postgres connection string used by the app and Alembic.
# Matches the default docker compose Postgres service (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://job_user:devpassword@localhost:5432/job_tracker

# When true, SQLAlchemy logs every SQL statement it runs (noisy; useful for debugging).
# Accepts: true/false, 1/0, yes/no. Defaults to false when unset.
SQL_ECHO=false
